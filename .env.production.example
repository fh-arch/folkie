# ============================================================
# Folkie Web Frontend — Production env example
# ============================================================
# These are baked into the Next.js image at build time (for
# NEXT_PUBLIC_*) or read at runtime (server-side variables).
# In the unified deploy, docker-compose.prod.yml in folkie_api
# passes these to the folkie-web container — this file is only
# for standalone/local production builds.
# ============================================================

NEXT_PUBLIC_API_URL=https://folkie.com.tr
NEXT_PUBLIC_SIGNALR_URL=https://folkie.com.tr/hubs/messaging

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

BACKEND_INTERNAL_URL=http://folkie-api:5069
