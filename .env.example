# Folkie Frontend (Next.js) — environment template
# Kopyala: cp .env.example .env.local

# ─── Backend API ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5050
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Folkie

# ─── Clerk (Auth) ────────────────────────────────────────────
# https://dashboard.clerk.com → Application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT template adı — Folkie API için özel template
# Dashboard → JWT Templates → "folkie-api" oluştur, claim'lere role ve email ekle
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=folkie-api

# Clerk yönlendirme URL'leri
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Sentry (Error Tracking, opsiyonel) ──────────────────────
NEXT_PUBLIC_SENTRY_DSN=
